# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Cache + runtime
.cache/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.playwright/

# Output (CSVs are runs, not source)
output/

# Node / extension
node_modules/
extension/dist/
extension/.parcel-cache/
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.pem
service-account*.json
credentials.json

# Local config — keep credentials / internal URLs / proxy lists out of git.
# Everything tracked lives under configs/ (see configs/README.md).
config.local.yaml
config.private.yaml
configs/local/
configs/**/*.local.yaml
configs/**/*.private.yaml

# Agent / tooling session files
.claude/
.serena/
.veris/

# Proxy lists (don't expose IPs publicly)
proxies.txt
proxies-*.txt
